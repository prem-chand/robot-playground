<mujoco model="cartpole">
  <compiler inertiafromgeom="false"/>
  <option timestep="0.002"/>
  <visual>
    <global offwidth="640" offheight="360" azimuth="90" elevation="-10"/>
  </visual>
  <default>
    <geom contype="0" conaffinity="0"/>
  </default>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".1"/>
  </asset>
  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" pos="0 0 -0.1" size="4 4 .1" material="grid"/>
    <geom name="rail" type="capsule" fromto="-3 0 0 3 0 0" size=".01" rgba=".5 .5 .5 1"/>
    <body name="cart">
      <camera name="lab" mode="trackcom" pos="0 -3 0.5" xyaxes="1 0 0 0 0 1"/>
      <joint name="slider" type="slide" axis="1 0 0"/>
      <inertial pos="0 0 0" mass="1.0" diaginertia=".01 .01 .01"/>
      <geom type="box" size=".12 .08 .05" rgba=".8 .5 .2 1"/>
      <body name="pole">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <inertial pos="0 0 0.4" mass="0.3" diaginertia=".016 .016 .0001"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.8" size=".02" rgba=".3 .7 .9 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="push" joint="slider" ctrlrange="-20 20"/>
  </actuator>
  <keyframe>
    <key name="home" qpos="0 0"/>
  </keyframe>
</mujoco>
