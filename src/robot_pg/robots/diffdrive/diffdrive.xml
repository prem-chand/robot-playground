<mujoco model="diffdrive">
  <!-- Explicit Euler at 2 ms cannot hold the wheel time constant of about 0.15 ms. -->
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global azimuth="200" elevation="-4"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="20 20 0.1" material="grid"/>
    <body name="base" pos="0 0 0.05">
      <freejoint/>
      <geom name="chassis" type="box" size="0.15 0.1 0.03" mass="3" rgba="0.8 0.5 0.2 1"/>
      <body name="left_wheel" pos="0 0.12 0">
        <joint name="left" axis="0 1 0"/>
        <geom name="left_wheel" type="cylinder" size="0.05 0.015" euler="90 0 0" friction="1.5"
          rgba="0.15 0.15 0.15 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.12 0">
        <joint name="right" axis="0 1 0"/>
        <geom name="right_wheel" type="cylinder" size="0.05 0.015" euler="90 0 0" friction="1.5"
          rgba="0.15 0.15 0.15 1"/>
      </body>
      <geom name="caster" type="sphere" size="0.02" pos="0.12 0 -0.03" friction="0 0 0" condim="1"
        rgba="0.6 0.6 0.6 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left" joint="left" kv="2" ctrlrange="-20 20"/>
    <velocity name="right" joint="right" kv="2" ctrlrange="-20 20"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0.0498 1 0 0 0 0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
